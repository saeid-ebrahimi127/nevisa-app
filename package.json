{
  "name": "nevisa-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 5000",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --port 5000",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "dev:db:seed": "bun run ./src/db/seed.server.ts",
    "prepare": "husky",
    "dev:email": "cp .env ./node_modules/@react-email/ui/.env && bun x react-email dev --dir ./src/email/templates --port 8005"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx})": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@better-auth/redis-storage": "^1.7.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "axios": "^1.19.0",
    "better-auth": "^1.5.3",
    "better-auth-localization": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "6.9.2",
    "react-hook-form": "^7.86.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "patchedDependencies": {
    "@tanstack/router-ssr-query-core@1.169.1": "patches/@tanstack%2Frouter-ssr-query-core@1.169.1.patch"
  }
}
